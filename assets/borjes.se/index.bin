&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Hos oss har du alltid 30 dagars &amp;ouml;ppet k&amp;ouml;p p&amp;aring; din best&amp;auml;llning. Returfrakten kostar 90 kr.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;Gratis retur i butik.&lt;/span&gt;&lt;/p&gt;
        &lt;/div&gt;
              &lt;div class=&quot;grid-item column text-center&quot;&gt;
          &lt;p&gt;&lt;img src=&quot;/image/8199/noun-delivery-3590821-152942.png&quot; alt=&quot;Snabbare leverans&quot; width=&quot;32&quot; height=&quot;32&quot;&gt;&lt;/p&gt;
